---
import Layout from '@/layouts/AdminLayout.astro'
import DeviceManager from '@/components/DeviceManager'
import { getPageSession, redirectForAuth } from '@/lib/auth-page'

const session = await getPageSession(Astro.cookies)
const redirectTo = redirectForAuth(session)
if (redirectTo) {
  return Astro.redirect(redirectTo)
}
---

<Layout title="デバイス">
  <h1 class="mb-6 text-2xl font-semibold text-gray-900">デバイス管理</h1>
  <DeviceManager client:load />
</Layout>
