---
import Layout from '@/layouts/AdminLayout.astro'
import { getPageSession, redirectForAuth } from '@/lib/auth-page'
import { UserDB } from '@/server/db'

const session = await getPageSession(Astro.cookies)
const redirectTo = redirectForAuth(session, { requireAdmin: true })
if (redirectTo) {
  return Astro.redirect(redirectTo)
}

const [userCount, adminCount] = await Promise.all([UserDB.count(), UserDB.countAdmins()])
---

<Layout title="ダッシュボード">
  <h1 class="mb-6 text-2xl font-semibold text-gray-900">管理者ダッシュボード</h1>
  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-lg bg-white p-6 shadow-sm">
      <p class="text-sm text-gray-500">ユーザー数</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900">{userCount}</p>
    </div>
    <div class="rounded-lg bg-white p-6 shadow-sm">
      <p class="text-sm text-gray-500">管理者数</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900">{adminCount}</p>
    </div>
  </div>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href="/admin/users"
      class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-primary-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 focus:outline-none"
    >
      ユーザー管理
    </a>
    <a
      href="/admin/apps"
      class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-primary-300 focus:outline-none"
    >
      アプリ
    </a>
  </div>
</Layout>
