---
import Layout from '@/layouts/FrontLayout.astro'
import ResetPasswordForm from '@/components/ResetPasswordForm'

const { token } = Astro.params
if (!token) {
  return Astro.redirect('/forgot-password')
}
---

<Layout title="復旧用パスワード">
  <h1 class="mb-6 text-2xl font-semibold text-gray-900">復旧用のパスワードを設定</h1>
  <ResetPasswordForm client:load token={token} />
</Layout>
