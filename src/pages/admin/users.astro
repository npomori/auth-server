---
import Layout from '@/layouts/AdminLayout.astro'
import AdminUsersSection from '@/components/AdminUsersSection'
import { getPageSession, redirectForAuth } from '@/lib/auth-page'

const session = await getPageSession(Astro.cookies)
const redirectTo = redirectForAuth(session, { requireUserManager: true })
if (redirectTo || !session) {
  return Astro.redirect(redirectTo ?? '/login')
}
---

<Layout title="ユーザー管理">
  <h1 class="mb-6 text-2xl font-semibold text-gray-900">ユーザー管理</h1>
  <AdminUsersSection client:load actorRole={session.user.role} />
</Layout>
