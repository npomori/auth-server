---
import Layout from '@/layouts/FrontLayout.astro'
import EmailChangeVerifyForm from '@/components/EmailChangeVerifyForm'

const { token } = Astro.params
if (!token) {
  return Astro.redirect('/login')
}
---

<Layout title="メールアドレスの確認">
  <h1 class="mb-6 text-2xl font-semibold text-gray-900">メールアドレスの確認</h1>
  <EmailChangeVerifyForm client:load token={token} />
</Layout>
