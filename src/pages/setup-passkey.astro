---
import Layout from '@/layouts/FrontLayout.astro'
import SetupPasskeyForm from '@/components/SetupPasskeyForm'
import { getPageSession, redirectForAuth } from '@/lib/auth-page'
import { homePathForRole } from '@/lib/user-role'

const session = await getPageSession(Astro.cookies)
const redirectTo = redirectForAuth(session, { allowWithoutPasskey: true })
if (redirectTo === '/login') {
  return Astro.redirect('/login')
}
if (session && !session.user.mustSetupPasskey) {
  return Astro.redirect(homePathForRole(session.user.role))
}
---

<Layout title="パスキー登録" showLogout>
  <h1 class="mb-6 text-2xl font-semibold text-gray-900">パスキーを登録</h1>
  <SetupPasskeyForm client:load />
</Layout>
