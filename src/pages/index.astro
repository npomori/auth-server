---
import Layout from '@/layouts/FrontLayout.astro'
import { homePathForRole } from '@/lib/user-role'
import { getPageSession } from '@/lib/auth-page'

const session = await getPageSession(Astro.cookies)

if (!session) {
  return Astro.redirect('/login')
}
if (session.user.mustSetupPasskey) {
  return Astro.redirect('/setup-passkey')
}
return Astro.redirect(homePathForRole(session.user.role))
---

<Layout title="Home">
  <p class="text-gray-600">リダイレクト中...</p>
</Layout>
